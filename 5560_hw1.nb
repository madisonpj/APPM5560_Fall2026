Cell[CellGroupData[{
Cell["APPM 5560 Homework 1", "Section",
 CellChangeTimes->{{3.996743007069357*^9, 
  3.9967430215767603`*^9}},ExpressionUUID->"f23c6399-95e9-45d0-83aa-\
b7899fbbd91d"],

Cell[CellGroupData[{

Cell["Question 3", "Subsection",
 CellChangeTimes->{{3.9967430537826805`*^9, 
  3.9967430553347416`*^9}},ExpressionUUID->"f77b1ed0-6db4-4f8d-817d-\
8da8decfe1bc"],

Cell[TextData[{
 "A uniform distribution PDF on [0,1] is defined as 1 for \[Theta] \[Element] \
(0,1) and 0 otherwise.\nThe uniform distribution CDF on [0,1] is 0 for \
\[Theta] < 0, the line y = \[Theta] (where y is the probability of \[Theta] < \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3c04a6c9-aca8-4426-831a-97b88086e49e"],
 ") and 1 for \[Theta] > 1.\nFor pretty looking graphs, they will be plotted \
using Mathematica, as opposed to by hand. "
}], "Text",
 CellChangeTimes->{{3.9967430923645935`*^9, 3.9967431799914756`*^9}, {
  3.996743266796793*^9, 
  3.9967434893265123`*^9}},ExpressionUUID->"5a0ea8cc-8e67-4a05-a068-\
c41455026268"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"UniformDistribution", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], "]"}], ",", "\[Theta]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", 
     RowBox[{"-", "0.3"}], ",", "1.3"}], "}"}], ",", 
   RowBox[{"ExclusionsStyle", "->", "Dashed"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "0.1"}], ",", "1.2"}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<PDF of Uniform[0,1]\>\""}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]\>\"", ",", "\"\<Density\>\""}], "}"}]}], ",", 
   RowBox[{"Axes", "->", 
    RowBox[{"{", 
     RowBox[{"True", ",", "False"}], "}"}]}]}], "]"}]], "Input",
